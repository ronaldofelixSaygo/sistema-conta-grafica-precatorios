// =====================================================================
// Sistema Conta Gráfica — Prisma schema
// Banco: Neon (PostgreSQL serverless)
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Roles ───────────────────────────────────────────────────────────
enum Role {
  ADM       // Administrador: enxerga e edita tudo (incl. usuários, audit)
  SAYGO     // Usuário Saygo: opera o sistema, vê dados de todos os clientes
  PARTNER   // Parceiro/Escritório: vê só clientes vinculados ao seu escritório
  CLIENT    // Cliente: vê só os próprios dados
}

// ─── Usuários da plataforma ──────────────────────────────────────────
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(CLIENT)

  // Para PARTNER: nome do escritório (deve bater com Cliente.escritorio)
  officeName   String?

  // Para CLIENT: id do Cliente vinculado (1-1, vê só ele)
  clienteId    Int?      @unique
  cliente      Cliente?  @relation("ClienteUser", fields: [clienteId], references: [id], onDelete: SetNull)

  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  // Preferência de tema do usuário (persistida)
  themePref    String    @default("dark") // 'dark' | 'light'

  // Avatar (foto do perfil). Guardado como bytes inline pra evitar dependência
  // de storage externo. Limitamos no upload pra ~2 MB.
  avatarBytes  Bytes?
  avatarMime   String?
  avatarUpdated DateTime?  // pra cache-busting do <img src>


  // Para PARTNER: pode estar vinculado a um cadastro de Parceiro (empresa)
  parceiroId   String?
  parceiro     Parceiro? @relation(fields: [parceiroId], references: [id], onDelete: SetNull)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Chat
  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  conversationsA   Conversation[] @relation("ConvUserA")
  conversationsB   Conversation[] @relation("ConvUserB")

  // Audit
  auditLogs    AuditLog[]

  // Kanban
  kanbanResponsibleFor KanbanStageProgress[] @relation("KanbanResponsible")
  kanbanUploaded       KanbanAttachment[]    @relation("KanbanUploader")

  // Partner requests
  partnerRequestsCreated   PartnerRequest[] @relation("PartnerRequestedBy")
  partnerRequestsResolved  PartnerRequest[] @relation("PartnerResolvedBy")

  // Comissões
  commissionsCreated   Commission[] @relation("CommissionCreatedBy")
  commissionsReviewed  Commission[] @relation("CommissionReviewedBy")

  // Solicitações de crédito
  creditRequestsRequested CreditRequest[] @relation("CreditRequestRequestedBy")
  creditRequestsResolved  CreditRequest[] @relation("CreditRequestResolvedBy")
  aiPromptsCreated        AiPromptVersion[] @relation("AiPromptCreatedBy")

  // Desonerações
  desoneracoesCreated  Desoneracao[]          @relation("DesoneracaoCreatedBy")
  desoneracaoSteps     DesoneracaoStep[]      @relation("DesoneracaoStepBy")
  desoneracaoDocs      DesoneracaoDocumento[] @relation("DesoneracaoDocBy")
  desoneracaoEventos   DesoneracaoEvento[]    @relation("DesoneracaoEventoBy")

  @@index([role])
  @@index([officeName])
  @@map("users")
}

// ─── Clientes (empresas atendidas) ──────────────────────────────────
model Cliente {
  id                  Int      @id @default(autoincrement())
  nome                String
  cnpj                String?
  cnpjFilial          String?
  escritorio          String?  // ⬅︎ vínculo do Parceiro (campo-chave do role PARTNER)
  locacaoSala         String?
  aberturaFilial      String?
  reativacaoIe        String?
  contaGrafica        String?
  clienteCertificado  String?
  parceiroSala        String?
  parceiroFilial      String?
  parceiroIe          String?
  observacoes         String?  @db.Text
  percentualComissao  Float    @default(0)
  diaFechamento       Int      @default(1)
  // Cliente com processo de execução DI/Duimp via Saygo: valor (R$) que o
  // escritório recebe por cada DI/Duimp processada (entra na apuração de
  // comissão como bloco separado). 0 ou null = cliente sem esse processo.
  valorPorDi          Float    @default(0)
  // Parceiro despachante associado a esse cliente (usado em Desonerações
  // pra pré-vincular como responsável da etapa DOCS_DESPACHANTE).
  despachanteId       String?
  despachante         Parceiro? @relation("ClienteDespachante", fields: [despachanteId], references: [id], onDelete: SetNull)
  // Parceiro do tipo Contabilidade vinculado ao cliente. Usuários PARTNER
  // com kindCode='CONTABILIDADE' só enxergam clientes onde figuram aqui.
  contabilidadeId     String?
  contabilidade       Parceiro? @relation("ClienteContabilidade", fields: [contabilidadeId], references: [id], onDelete: SetNull)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  movimentacoes       Movimentacao[]
  user                User?    @relation("ClienteUser")
  kanbanCard          KanbanCard?
  partnerRequests     PartnerRequest[]
  creditRequests      CreditRequest[]
  desoneracoes        Desoneracao[]

  @@index([escritorio])
  @@index([nome])
  @@map("clientes")
}

// ─── Movimentações (lançamentos) ────────────────────────────────────
model Movimentacao {
  id                Int      @id @default(autoincrement())
  clienteId         Int
  tipoMovimento     String   // 'Créditos Reconhecidos e Cedidos' | 'Débitos de Liquidações' | 'Débitos de Transferências'
  dataNf            DateTime?
  duimpDiProcesso   String?
  parceiro          String?  // copiado do escritorio do cliente no momento do lançamento
  dataExoneracao    DateTime?
  percentual        Float    @default(0)
  valor             Float    @default(0)
  valorAjustado     Float    @default(0)  // calculado: positivo p/ crédito, negativo p/ débito

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cliente           Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  desoneracao       Desoneracao? @relation("DesoneracaoMovimentacao")

  @@index([clienteId])
  @@index([tipoMovimento])
  @@index([dataNf])
  @@index([parceiro])
  @@map("movimentacoes")
}

// ─── Audit log ──────────────────────────────────────────────────────
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    String?
  userName  String?
  action    String   // CREATE | UPDATE | DELETE | LOGIN | etc
  entity    String?  // 'cliente' | 'movimentacao' | 'user' | etc
  entityId  String?
  details   String?  @db.Text
  ip        String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("audit_log")
}

// ─── Chat: conversa entre dois usuários ─────────────────────────────
model Conversation {
  id          String    @id @default(uuid())
  userAId     String
  userBId     String
  lastMessage String?
  lastAt      DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userA       User      @relation("ConvUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB       User      @relation("ConvUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([userAId, userBId])
  @@index([lastAt])
  @@map("conversations")
}

// ─── Chat: mensagem ─────────────────────────────────────────────────
model Message {
  id             String       @id @default(uuid())
  conversationId String
  fromUserId     String
  toUserId       String
  content        String       @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  from           User         @relation("SentMessages",     fields: [fromUserId], references: [id], onDelete: Cascade)
  to             User         @relation("ReceivedMessages", fields: [toUserId],   references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([toUserId, readAt])
  @@map("messages")
}

// ============================================================
//   KANBAN DE HABILITAÇÃO (etapas e atividades dinâmicas)
// ============================================================
// As etapas e atividades são totalmente configuráveis pelo Adm.
// KanbanStageDef + KanbanActivityDef são fonte da verdade.
// stage em KanbanCard / KanbanStageProgress = key da etapa (string).

enum KanbanStageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

// ─── Definição da etapa (cadastro pelo Adm) ──────────────────────────
model KanbanStageDef {
  id                     String  @id @default(uuid())
  key                    String  @unique  // identificador estável, ex "ONBOARDING", "CONCLUIDO"
  label                  String
  order                  Int     @default(0)
  slaHours               Int     @default(72)
  defaultResponsibleRole Role?
  active                 Boolean @default(true)
  isFinal                Boolean @default(false) // marca a etapa de "Concluído"

  activities             KanbanActivityDef[]
  updatedAt              DateTime @updatedAt
  createdAt              DateTime @default(now())

  @@map("kanban_stage_defs")
}

// ─── Atividade configurada para uma etapa ────────────────────────────
model KanbanActivityDef {
  id        String         @id @default(uuid())
  stageId   String
  stage     KanbanStageDef @relation(fields: [stageId], references: [id], onDelete: Cascade)
  label     String
  order     Int            @default(0)
  active    Boolean        @default(true)
  updatedAt DateTime       @updatedAt
  createdAt DateTime       @default(now())

  @@index([stageId])
  @@map("kanban_activity_defs")
}

model KanbanCard {
  id           String   @id @default(uuid())
  clienteId    Int      @unique
  cliente      Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  // currentStage = key da etapa atual (referencia KanbanStageDef.key)
  currentStage String
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stages       KanbanStageProgress[]
  attachments  KanbanAttachment[]

  @@index([currentStage])
  @@map("kanban_cards")
}

model KanbanStageProgress {
  id                 String       @id @default(uuid())
  cardId             String
  card               KanbanCard   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  // key da etapa (KanbanStageDef.key)
  stage              String
  status             KanbanStageStatus @default(PENDING)

  // SLA: horas previstas pra concluir essa etapa
  slaHours           Int          @default(72)
  // calculado: previsto = startedAt + slaHours; realizado = completedAt - startedAt
  startedAt          DateTime?
  completedAt        DateTime?

  // Parceiro/empresa que executa a etapa (do cadastro de Parceiros)
  parceiroId         String?
  parceiro           Parceiro?    @relation(fields: [parceiroId], references: [id], onDelete: SetNull)

  // Responsável pela etapa: pode ser um user específico (Cliente, Parceiro ou Saygo)
  responsibleUserId  String?
  responsibleUser    User?        @relation("KanbanResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  // Ou apenas o tipo (caso ainda não tenha definido o user específico)
  responsibleRole    Role?

  // Checklist de itens a marcar antes de concluir a etapa.
  // Formato: [{"label":"Documento X assinado","done":true}, {...}]
  checklist          Json         @default("[]")
  notes              String?      @db.Text

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  attachments        KanbanAttachment[]

  @@unique([cardId, stage])
  @@index([status])
  @@index([responsibleUserId])
  @@map("kanban_stage_progress")
}

model KanbanAttachment {
  id           String     @id @default(uuid())
  cardId       String
  card         KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  // anexo pode estar atrelado a uma etapa específica (ou ao card como um todo)
  stageProgressId String?
  stageProgress   KanbanStageProgress? @relation(fields: [stageProgressId], references: [id], onDelete: SetNull)

  filename     String
  mimeType     String
  size         Int
  content      Bytes      // bytea - arquivo armazenado no banco

  uploadedById String?
  uploadedBy   User?      @relation("KanbanUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@index([cardId])
  @@index([stageProgressId])
  @@map("kanban_attachments")
}

// ============================================================
//   ACIONAMENTO DO PARCEIRO (alimentação de conta gráfica, etc)
// ============================================================
enum PartnerRequestType {
  ALIMENTACAO_CONTA_GRAFICA
  // outros tipos podem ser adicionados depois
}

enum PartnerRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELED
}

model PartnerRequest {
  id           String                @id @default(uuid())
  clienteId    Int
  cliente      Cliente               @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  type         PartnerRequestType
  status       PartnerRequestStatus  @default(OPEN)

  // payload livre — para alimentação irá conter os parâmetros de cálculo
  payload      Json                  @default("{}")
  message      String?               @db.Text

  // quem solicitou (cliente ou Saygo) e quem é o parceiro alvo
  requestedById String
  requestedBy   User                 @relation("PartnerRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  partnerOfficeName String           // = cliente.escritorio (snapshot)
  resolvedById  String?
  resolvedBy    User?                @relation("PartnerResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt    DateTime              @default(now())
  resolvedAt   DateTime?

  @@index([clienteId])
  @@index([partnerOfficeName, status])
  @@index([status])
  @@map("partner_requests")
}

// ============================================================
//   PARCEIROS (cadastro de empresas que prestam serviço)
// ============================================================
// PartnerType permanece como "bucket de capacidades" que o código consulta pra
// decidir o que cada parceiro pode fazer. Os TIPOS visíveis pro usuário ficam
// no model PartnerKind abaixo (cadastráveis em Parâmetros).
enum PartnerType {
  ESCRITORIO          // vê tudo (clientes, movs, comissões)
  ARMADOR_LOGISTICO   // só Kanban
  OUTRO               // só Kanban (default seguro)
}

// Tipos de interveniente cadastráveis. Os 3 built-in (ESCRITORIO,
// ARMADOR_LOGISTICO, OUTRO) são criados automaticamente no boot e não podem
// ser deletados. O admin pode criar outros (ex.: CONTABILIDADE, DESPACHANTE).
model PartnerKind {
  id          String      @id @default(uuid())
  code        String      @unique  // ex.: 'ESCRITORIO', 'CONTABILIDADE'
  label       String                // ex.: 'Escritório', 'Contabilidade'
  behavior    PartnerType            // capacidade herdada
  description String?
  active      Boolean     @default(true)
  isBuiltin   Boolean     @default(false)
  sort        Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  parceiros   Parceiro[]
  rolePermissions RolePermission[]
  @@map("partner_kinds")
}

model Parceiro {
  id        String      @id @default(uuid())
  nome      String
  cnpj      String?
  telefone  String?
  email     String?
  type      PartnerType @default(OUTRO)
  kindCode  String?
  kind      PartnerKind? @relation(fields: [kindCode], references: [code])
  stages    String[]
  isSaygo   Boolean     @default(false)
  active    Boolean     @default(true)
  notes     String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  users           User[]
  kanbanStages    KanbanStageProgress[]
  commissions     Commission[] @relation("CommissionParceiro")
  desoneracaoSteps DesoneracaoStep[] @relation("DesoneracaoStepParceiro")
  clientesDespachante Cliente[] @relation("ClienteDespachante")
  clientesContabilidade Cliente[] @relation("ClienteContabilidade")

  @@index([nome])
  @@index([cnpj])
  @@index([type])
  @@index([kindCode])
  @@map("parceiros")
}

// ============================================================
//   COMISSÕES (apuração persistida + lançamentos extras)
// ============================================================
enum CommissionStatus {
  DRAFT      // parceiro está montando
  SUBMITTED  // enviada para Saygo aprovar
  APPROVED   // aceita
  REJECTED   // rejeitada (com motivo) — parceiro pode editar
  CLOSED     // fechada (não pode mais editar)
}

model Commission {
  id            String           @id @default(uuid())
  parceiroId    String
  parceiro      Parceiro         @relation("CommissionParceiro", fields: [parceiroId], references: [id], onDelete: Cascade)
  // mês de referência: YYYY-MM
  monthRef      String
  totalBase         Float        @default(0) // soma total das comissões dos clientes (créditos + DIs)
  totalBaseCredito  Float        @default(0) // bloco: comissão sobre créditos (%)
  totalBaseDi       Float        @default(0) // bloco: comissão fixa por DI/Duimp
  totalExtras       Float        @default(0) // adições/reduções manuais
  totalFinal        Float        @default(0) // totalBase + totalExtras
  detalhes      Json             @default("[]") // snapshot dos cálculos por cliente
  status        CommissionStatus @default(DRAFT)
  rejectReason  String?          @db.Text
  createdById   String
  createdBy     User             @relation("CommissionCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  reviewedById  String?
  reviewedBy    User?            @relation("CommissionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  extras        CommissionExtra[]

  @@unique([parceiroId, monthRef])
  @@index([status])
  @@map("commissions")
}

model CommissionExtra {
  id           String     @id @default(uuid())
  commissionId String
  commission   Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  description  String     // o que é o lançamento
  amount       Float      // positivo = adição, negativo = redução
  createdAt    DateTime   @default(now())

  @@index([commissionId])
  @@map("commission_extras")
}

// ============================================================
//   CONFIG DE ETAPAS DO KANBAN (editável pelo Adm)
// ============================================================
// ============================================================
//   CONFIGURAÇÃO DE E-MAIL (SMTP) — singleton (id fixo "default")
// ============================================================
model EmailSettings {
  id          String   @id @default("default")
  enabled     Boolean  @default(false)

  // === Padrão Saygo (API custom) ===
  apiUrl      String?  // Ex.: https://fn4lvdgkug.execute-api.sa-east-1.amazonaws.com/v1/send
  apiToken    String?  // x-access-token da API
  sender      String?  // Email remetente (campo "sender" no payload)

  // === Legacy SMTP (mantido pra compatibilidade — não usado pelo novo sender) ===
  host        String?
  port        Int      @default(587)
  secure      Boolean  @default(false)
  user        String?
  pass        String?
  fromAddress String?
  fromName    String?  @default("Sistema Conta Gráfica - Saygo")

  // Triggers ligados/desligados
  notifyKanbanStageChange  Boolean @default(true)
  notifyKanbanStageDone    Boolean @default(true)
  notifyPartnerRequest     Boolean @default(true)
  notifyCreditRequest      Boolean @default(true)

  // Quais perfis recebem cada tipo de notificação (array de roles: ADM, SAYGO, PARTNER, CLIENT)
  notifyKanbanStageChangeRoles Json @default("[\"ADM\",\"SAYGO\",\"PARTNER\",\"CLIENT\"]")
  notifyKanbanStageDoneRoles   Json @default("[\"ADM\",\"SAYGO\",\"PARTNER\",\"CLIENT\"]")
  notifyPartnerRequestRoles    Json @default("[\"ADM\",\"SAYGO\",\"PARTNER\"]")
  notifyCreditRequestRoles     Json @default("[\"ADM\",\"SAYGO\",\"PARTNER\"]")

  // Lista fixa de e-mails que recebem briefing diário (separados por ; ou ,)
  briefingRecipients String? @db.Text

  updatedAt   DateTime @updatedAt

  @@map("email_settings")
}

// ============================================================
//   IA — Configurações + Prompt + Solicitações de Crédito
// ============================================================
model AiSettings {
  id            String   @id @default("default")
  provider      String   @default("anthropic") // anthropic | openai | gemini | groq
  model         String?
  apiKey        String?
  systemPrompt  String?  @db.Text
  enabled       Boolean  @default(false)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@map("ai_settings")
}

// Histórico de versões do prompt usado para extrair invoice
model AiPromptVersion {
  id          String   @id @default(uuid())
  version     Int      @default(autoincrement())
  content     String   @db.Text
  active      Boolean  @default(false)
  createdById String?
  createdBy   User?    @relation("AiPromptCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([active])
  @@map("ai_prompt_versions")
}

enum CreditRequestStatus {
  DRAFT       // só rascunho local
  SENT        // enviado pro escritório
  IN_PROGRESS // escritório resolvendo
  RESOLVED    // concluído (com ou sem anexos)
  CANCELED
}

model CreditRequest {
  id              String   @id @default(uuid())
  clienteId       Int
  cliente         Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  // snapshot do escritório do cliente (parceiro alvo)
  partnerOfficeName String

  // dados de entrada da invoice (formulário ou extraídos de PDF)
  inputs          Json     @default("{}")
  // resultado completo do cálculo (subtotal, custos, ICMS dos cenários, economia, etc.)
  result          Json     @default("{}")
  // valor final de créditos a comprar (referência rápida — vem de result.icms_al_nf por padrão)
  creditosACompar Float    @default(0)
  modalidade      String   @default("AL_NF") // AL_NF (4%) | AL_DIF (1.2%)

  // Anexos do PDF de entrada (opcional)
  inputPdfName    String?
  inputPdfBytes   Bytes?

  // anexo de evidência da resolução (opcional — não bloqueia conclusão)
  resolutionAttachmentName  String?
  resolutionAttachmentMime  String?
  resolutionAttachmentBytes Bytes?
  resolutionNote  String?  @db.Text

  status          CreditRequestStatus @default(DRAFT)
  message         String?  @db.Text

  requestedById   String
  requestedBy     User     @relation("CreditRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  resolvedById    String?
  resolvedBy      User?    @relation("CreditRequestResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  // Versão do prompt usado para a extração via IA (rastreabilidade)
  aiPromptVersion Int?

  createdAt       DateTime @default(now())
  sentAt          DateTime?
  // Quando a solicitação foi aceita pelo responsável (status SENT → IN_PROGRESS).
  // Usado pra cálculo de aderência SLA na fase "tempo pra começar a tratar".
  inProgressAt    DateTime?
  resolvedAt      DateTime?
  updatedAt       DateTime @updatedAt

  // Desonerações vinculadas (1 solicitação pode gerar várias desonerações no tempo)
  desoneracoes    Desoneracao[]

  @@index([clienteId])
  @@index([partnerOfficeName, status])
  @@index([status])
  @@map("credit_requests")
}

// ============================================================
//   NCM LOOKUP — tributos federais, anuentes e ICMS por UF
// ============================================================
// Tabela de tributos federais por NCM. Lookup por código exato, com
// fallback hierárquico (8 dígitos → 6 → 4 → 2) feito no service.
model NcmTributo {
  ncm         String   @id           // ex.: "85176259" (8 dígitos sem ponto)
  descricao   String?
  ii_aliq     Float    @default(0)   // % II
  ipi_aliq    Float    @default(0)   // % IPI
  pis_aliq    Float    @default(2.1) // % PIS importação
  cofins_aliq Float    @default(9.65)// % COFINS importação
  observacoes String?  @db.Text
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("ncm_tributos")
}

// Órgãos anuentes que controlam o NCM (ANVISA, MAPA, INMETRO, ANATEL etc.)
model NcmAnuente {
  id          String   @id @default(uuid())
  ncm         String                  // pode ser prefixo (ex.: "8517") ou código completo
  anuente     String                  // ANATEL, ANVISA, MAPA, INMETRO, IBAMA, etc.
  descricao   String?
  obrigatorio Boolean  @default(true) // false = anuência condicional
  observacoes String?  @db.Text
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([ncm])
  @@map("ncm_anuentes")
}

// Alíquota de ICMS interna padrão por UF (fallback quando o cliente não tem TTD/regime especial)
model IcmsUf {
  uf          String   @id           // 2 letras: "AL", "SP", etc.
  aliq        Float    @default(18)  // % ICMS interna padrão
  observacoes String?
  updatedAt   DateTime @updatedAt

  @@map("icms_uf")
}

model EmailLog {
  id        String   @id @default(uuid())
  to        String
  subject   String
  status    String   // 'sent' | 'error'
  error     String?
  context   String?  // ex: 'kanban_stage', 'partner_request'
  contextId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("email_log")
}

// (KanbanStageConfig foi removido — agora usamos KanbanStageDef + KanbanActivityDef)

// ============================================================
//   PERMISSÕES POR PERFIL (parâmetros)
// ============================================================
// Matriz role × kind × módulo. ADM gerencia na tela Parâmetros.
// Para roles que não são PARTNER (ADM/SAYGO/CLIENT), partnerKindCode é null.
// Para PARTNER, há uma linha por PartnerKind (incluindo customizados como Contabilidade).
model RolePermission {
  id              String        @id @default(uuid())
  role            Role
  partnerType     PartnerType?  // legado — derivado do kind.behavior, mantido por compat
  partnerKindCode String?       // primário pra PARTNER — referencia PartnerKind.code
  partnerKind     PartnerKind?  @relation(fields: [partnerKindCode], references: [code], onDelete: Cascade, onUpdate: Cascade)
  module          String
  canView         Boolean       @default(true)
  canCreate       Boolean       @default(false)
  canEdit         Boolean       @default(false)
  canDelete       Boolean       @default(false)
  // Campos da entidade que devem ser ocultados do retorno (lista de strings).
  restrictedFields Json         @default("[]")
  updatedAt       DateTime      @updatedAt

  @@unique([role, partnerKindCode, module])
  @@index([partnerKindCode])
  @@map("role_permissions")
}

// ============================================================
//   DESONERAÇÕES (processo operacional pós-aquisição de crédito)
// ============================================================
// Fluxo: cliente comprou crédito (via CreditRequest) → despachante envia docs
// da importação → Saygo Alagoas emite DMI → cliente emite NFs → Saygo valida
// → cliente envia NFs oficiais → Saygo protocola exoneração → conclusão.
// Cada etapa registra o parceiro responsável (DesoneracaoStep) pra permitir
// consolidação por parceiro (despachante, contabilidade, etc).
enum DesonModal {
  MARITIMO
  AEREO
  RODOVIARIO
}

enum DesonStatus {
  EM_ANDAMENTO
  AGUARDANDO_APROVACAO  // todas etapas concluídas, aguarda parceiro aprovar criação da movimentação
  CONCLUIDA
  CANCELADA
}

enum DesonStep {
  DOCS_DESPACHANTE      // despachante envia DUIMP/PL/PI/AFRMM/BL/CCT
  EMISSAO_DMI           // Saygo emite DMI
  EMISSAO_NF            // cliente emite NFs (entrada + saída)
  VALIDACAO_NF          // Saygo valida fiscalmente
  ENVIO_NF_OFICIAL      // cliente envia NFs oficiais (PDFs)
  PROTOCOLO_ICMS        // Saygo protocola exoneração ICMS
  CONCLUIDO             // estado final
}

model Desoneracao {
  id              String   @id @default(uuid())
  clienteId       Int
  cliente         Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  // Rastreabilidade: vincula opcionalmente à Solicitação de Créditos que originou
  creditRequestId String?
  creditRequest   CreditRequest? @relation(fields: [creditRequestId], references: [id], onDelete: SetNull)

  numeroProcesso  String?      // identificação amigável (auto-gerado ou manual)
  duimpDi         String?      // número do DUIMP/DI
  modal           DesonModal

  // Valores principais
  valorMercadoria     Float?
  valorIcmsDesonerado Float?

  status        DesonStatus  @default(EM_ANDAMENTO)
  currentStep   DesonStep    @default(DOCS_DESPACHANTE)
  cancelReason  String?      @db.Text
  concludedAt   DateTime?

  // Movimentação gerada na conclusão (opcional — aprovada pelo parceiro do protocolo)
  movimentacaoId Int?     @unique
  movimentacao   Movimentacao? @relation("DesoneracaoMovimentacao", fields: [movimentacaoId], references: [id], onDelete: SetNull)

  createdById   String
  createdBy     User      @relation("DesoneracaoCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  steps         DesoneracaoStep[]
  notas         DesoneracaoNota[]
  documentos    DesoneracaoDocumento[]
  eventos       DesoneracaoEvento[]

  @@index([clienteId])
  @@index([status])
  @@index([currentStep])
  @@index([creditRequestId])
  @@map("desoneracoes")
}

model DesoneracaoStep {
  id             String       @id @default(uuid())
  desoneracaoId  String
  desoneracao    Desoneracao  @relation(fields: [desoneracaoId], references: [id], onDelete: Cascade)
  etapa          DesonStep
  parceiroId     String?      // parceiro responsável por essa etapa específica
  parceiro       Parceiro?    @relation("DesoneracaoStepParceiro", fields: [parceiroId], references: [id], onDelete: SetNull)
  // Timestamps de SLA: startedAt = quando a etapa virou a atual; completedAt = quando avançou.
  startedAt      DateTime?
  completedAt    DateTime?
  completedById  String?
  completedBy    User?        @relation("DesoneracaoStepBy", fields: [completedById], references: [id], onDelete: SetNull)
  notes          String?      @db.Text

  @@unique([desoneracaoId, etapa])
  @@index([parceiroId])
  @@map("desoneracao_steps")
}

model DesoneracaoNota {
  id             String       @id @default(uuid())
  desoneracaoId  String
  desoneracao    Desoneracao  @relation(fields: [desoneracaoId], references: [id], onDelete: Cascade)
  tipo           String       // 'ENTRADA' | 'SAIDA'
  numero         String
  serie          String?
  dataEmissao    DateTime?
  valor          Float        @default(0)

  validada       Boolean      @default(false)
  validadaAt     DateTime?
  validadaPorId  String?
  // Rejeição: marca NF que o parceiro reprovou na etapa VALIDACAO_NF.
  // Cliente substitui (anexa nova) e exclui essa via soft delete.
  rejeitada      Boolean      @default(false)
  rejeitadaAt    DateTime?
  rejeitadaMotivo String?
  // Soft delete: nota excluída pelo cliente após rejeição. Some das listagens
  // mas fica no banco pra preservar trilha de auditoria + permitir mostrar no
  // histórico do processo (motivo, tipo, arquivo original).
  deletedAt      DateTime?
  deletedById    String?

  // PDF oficial — anexado na etapa ENVIO_NF_OFICIAL
  oficialBytes   Bytes?
  oficialNome    String?
  oficialMime    String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([desoneracaoId])
  @@map("desoneracao_notas")
}

model DesoneracaoDocumento {
  id             String       @id @default(uuid())
  desoneracaoId  String
  desoneracao    Desoneracao  @relation(fields: [desoneracaoId], references: [id], onDelete: Cascade)
  tipo           String       // 'DUIMP' | 'PL' | 'PI' | 'AFRMM' | 'BL' | 'CCT' | 'DMI' | 'DESPACHO' | 'OUTRO'
  nome           String
  mime           String
  bytes          Bytes
  uploadedById   String
  uploadedBy     User         @relation("DesoneracaoDocBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([desoneracaoId])
  @@index([tipo])
  @@map("desoneracao_documentos")
}

model DesoneracaoEvento {
  id             String       @id @default(uuid())
  desoneracaoId  String
  desoneracao    Desoneracao  @relation(fields: [desoneracaoId], references: [id], onDelete: Cascade)
  etapa          DesonStep?
  acao           String       // 'CRIADA' | 'ETAPA_AVANCADA' | 'DOC_ANEXADO' | 'NF_VALIDADA' | etc
  descricao      String?      @db.Text
  byUserId       String
  byUser         User         @relation("DesoneracaoEventoBy", fields: [byUserId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([desoneracaoId])
  @@map("desoneracao_eventos")
}

// Config admin: marca documentos como obrigatórios por etapa × modal.
// Se obrigatorio=true e documento não foi anexado, o avanço da etapa é bloqueado.
model DesoneracaoDocConfig {
  id            String   @id @default(uuid())
  modal         String   // 'MARITIMO' | 'AEREO' | 'RODOVIARIO' | 'TODOS'
  etapa         String   // DesonStep code
  tipoDocumento String   // 'DUIMP' | 'PL' | 'PI' | etc
  obrigatorio   Boolean  @default(true)
  sort          Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([modal, etapa, tipoDocumento])
  @@map("desoneracao_doc_config")
}

// Config admin: define o TIPO DE RESPONSÁVEL por etapa. Determina quem
// pode avançar cada etapa via permissão runtime (cliente, parceiro de um
// kind específico, ou ambos como fallback).
//
// responsavelTipo:
//   - 'CLIENTE'             → só o cliente do processo
//   - 'PARCEIRO_KIND'       → parceiro do kindCode informado, vinculado ao processo
//   - 'CLIENTE_OU_PARCEIRO' → CLIENTE ou parceiro do kindCode (DOCS_DESPACHANTE usa isso)
//   - 'SAYGO'               → só ADM/SAYGO
// Estado de alertas do sistema (key-value) — usado pra throttling de
// notificações automáticas (ex: storage 80% não pode mandar e-mail toda hora).
model SystemAlert {
  key        String   @id  // ex.: 'storage_80_percent'
  lastSentAt DateTime
  payload    Json?    // opcional: snapshot do que disparou
  @@map("system_alerts")
}

// Config de SLA pra fluxo de Solicitação de Crédito. Key-value simples,
// 2 linhas: SENT_TO_PROGRESS, IN_PROGRESS_TO_RESOLVED.
model CreditSlaConfig {
  fase     String   @id   // SENT_TO_PROGRESS | IN_PROGRESS_TO_RESOLVED
  slaHours Int      @default(24)
  label    String?
  updatedAt DateTime @updatedAt
  @@map("credit_sla_config")
}

// Tipos de documento configuráveis em Parâmetros. Substitui a lista hardcoded
// em código — admin pode renomear/criar/desativar tipos sem novo deploy.
model DesoneracaoDocTipo {
  id        String   @id @default(uuid())
  code      String   @unique          // ex.: 'CTE_AWB_BL', 'DUIMP'
  label     String                    // ex.: 'Conhecimento (CTE/AWB/BL)'
  descricao String?
  sort      Int      @default(0)
  active    Boolean  @default(true)
  isBuiltin Boolean  @default(false)  // seed automático; não pode ser deletado
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("desoneracao_doc_tipos")
}

model DesoneracaoStepConfig {
  id              String   @id @default(uuid())
  etapa           String   @unique
  responsavelTipo String   @default("SAYGO")
  kindCode        String?  // quando relevante: ESCRITORIO, DESPACHANTE, etc.
  label           String?  // texto exibido na UI
  sort            Int      @default(0)
  // SLA: horas previstas pra concluir a etapa (configurável depois em Parâmetros)
  slaHours        Int      @default(48)
  updatedAt       DateTime @updatedAt

  @@map("desoneracao_step_config")
}

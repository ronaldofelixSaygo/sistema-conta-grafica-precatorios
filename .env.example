# =====================================================================
# Sistema Conta Gráfica — variáveis de ambiente
# =====================================================================
# Copie para `.env` e preencha. Nunca commitar `.env`.

# ─── Servidor ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Neon (PostgreSQL) ───────────────────────────────────────────────
# console.neon.tech > Project > Connection Details (com ?sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# ─── JWT ─────────────────────────────────────────────────────────────
JWT_SECRET="troque-isso-por-uma-string-secreta-bem-longa-em-producao"
JWT_EXPIRES_IN=12h

# ─── Seed inicial (1º admin) ─────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@saygogroup.com.br
SEED_ADMIN_PASSWORD=TrocarEssaSenhaJa!
SEED_ADMIN_NAME=Administrador

# ─── CORS (apenas se frontend for em domínio separado) ───────────────
CORS_ORIGIN=*

# ─── Migração do SQLite antigo (opcional, só na primeira vez) ────────
# Caminho local para o database.sqlite do sistema antigo. Se vazio, pula.
LEGACY_SQLITE_PATH=
